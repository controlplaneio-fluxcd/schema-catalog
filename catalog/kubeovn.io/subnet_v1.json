{
  "properties": {
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[^0-9]",
          "type": "string"
        }
      },
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "acls": {
          "description": "Access control lists for the subnet.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "allow-related",
                  "allow-stateless",
                  "allow",
                  "drop",
                  "reject"
                ],
                "type": "string"
              },
              "direction": {
                "enum": [
                  "from-lport",
                  "to-lport"
                ],
                "type": "string"
              },
              "match": {
                "type": "string"
              },
              "priority": {
                "maximum": 32767,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "allowEWTraffic": {
          "description": "Allow east-west traffic between pods.",
          "type": "boolean"
        },
        "allowSubnets": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cidrBlock": {
          "description": "CIDR block for the subnet. Immutable after creation.",
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "dhcpV4Options": {
          "type": "string"
        },
        "dhcpV6Options": {
          "type": "string"
        },
        "disableGatewayCheck": {
          "type": "boolean"
        },
        "disableInterConnection": {
          "type": "boolean"
        },
        "enableDHCP": {
          "description": "Enable DHCP for the subnet.",
          "type": "boolean"
        },
        "enableEcmp": {
          "type": "boolean"
        },
        "enableExternalLBAddress": {
          "type": "boolean"
        },
        "enableIPv6RA": {
          "type": "boolean"
        },
        "enableLb": {
          "type": "boolean"
        },
        "enableMulticastSnoop": {
          "type": "boolean"
        },
        "excludeIps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "externalEgressGateway": {
          "type": "string"
        },
        "gateway": {
          "description": "Gateway IP address for the subnet.",
          "type": "string"
        },
        "gatewayNode": {
          "type": "string"
        },
        "gatewayType": {
          "type": "string"
        },
        "ipv6RAConfigs": {
          "type": "string"
        },
        "logicalGateway": {
          "type": "boolean"
        },
        "mtu": {
          "maximum": 65535,
          "minimum": 68,
          "type": "integer"
        },
        "namespaceSelectors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "matchExpressions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "operator": {
                      "type": "string"
                    },
                    "values": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "matchLabels": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "namespaces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "natOutgoing": {
          "description": "Enable NAT for outgoing traffic.",
          "type": "boolean"
        },
        "natOutgoingPolicyRules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "nat",
                  "forward"
                ],
                "type": "string"
              },
              "match": {
                "additionalProperties": false,
                "properties": {
                  "dstIPs": {
                    "type": "string"
                  },
                  "srcIPs": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "policyRoutingPriority": {
          "maximum": 32765,
          "minimum": 1,
          "type": "integer"
        },
        "policyRoutingTableID": {
          "maximum": 2147483647,
          "minimum": 1,
          "not": {
            "enum": [
              252,
              253,
              254,
              255
            ]
          },
          "type": "integer"
        },
        "private": {
          "type": "boolean"
        },
        "protocol": {
          "description": "Network protocol (IPv4, IPv6, or Dual). Immutable after creation.",
          "enum": [
            "IPv4",
            "IPv6",
            "Dual"
          ],
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "routeTable": {
          "type": "string"
        },
        "u2oFeatures": {
          "additionalProperties": false,
          "properties": {
            "overlayOnlyRouting": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "u2oInterconnection": {
          "type": "boolean"
        },
        "u2oInterconnectionIP": {
          "type": "string"
        },
        "vips": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vlan": {
          "description": "VLAN ID for the subnet. Immutable after creation.",
          "type": "string"
        },
        "vpc": {
          "description": "VPC name for the subnet. Immutable after creation.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "activateGateway": {
          "type": "string"
        },
        "conditions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "lastTransitionTime": {
                "type": "string"
              },
              "lastUpdateTime": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "dhcpV4OptionsUUID": {
          "type": "string"
        },
        "dhcpV6OptionsUUID": {
          "type": "string"
        },
        "mcastQuerierIP": {
          "type": "string"
        },
        "mcastQuerierMAC": {
          "type": "string"
        },
        "natOutgoingPolicyRules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "nat",
                  "forward"
                ],
                "type": "string"
              },
              "match": {
                "additionalProperties": false,
                "properties": {
                  "dstIPs": {
                    "type": "string"
                  },
                  "srcIPs": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "ruleID": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "u2oInterconnectionIP": {
          "type": "string"
        },
        "u2oInterconnectionMAC": {
          "type": "string"
        },
        "u2oInterconnectionVPC": {
          "type": "string"
        },
        "v4availableIPrange": {
          "type": "string"
        },
        "v4availableIPs": {
          "type": "number"
        },
        "v4usingIPrange": {
          "type": "string"
        },
        "v4usingIPs": {
          "type": "number"
        },
        "v6availableIPrange": {
          "type": "string"
        },
        "v6availableIPs": {
          "type": "number"
        },
        "v6usingIPrange": {
          "type": "string"
        },
        "v6usingIPs": {
          "type": "number"
        }
      },
      "type": "object"
    }
  },
  "type": "object",
  "x-flux-schema-type": "Subnet"
}
