{
  "properties": {
    "spec": {
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "additionalProperties": false,
          "description": "Selects Nodes to which this AntreaNodeConfig applies.",
          "properties": {
            "matchExpressions": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "operator": {
                    "enum": [
                      "In",
                      "NotIn",
                      "Exists",
                      "DoesNotExist"
                    ],
                    "type": "string"
                  },
                  "values": {
                    "items": {
                      "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])?$",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "matchLabels": {
              "x-kubernetes-preserve-unknown-fields": true
            }
          },
          "type": "object"
        },
        "secondaryNetwork": {
          "additionalProperties": false,
          "description": "Secondary network bridge configuration for the selected Nodes.",
          "properties": {
            "ovsBridges": {
              "description": "OVS bridge configurations for secondary networks. At the moment, only a single OVS bridge is supported.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "bridgeName": {
                    "description": "Name of the OVS bridge.",
                    "maxLength": 15,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9._-]+$",
                    "type": "string"
                  },
                  "enableMulticastSnooping": {
                    "default": false,
                    "description": "Enable multicast snooping on the bridge so that multicast traffic is forwarded only to ports with interested receivers. Defaults to false.",
                    "type": "boolean"
                  },
                  "physicalInterfaces": {
                    "description": "Physical interfaces to be connected to this bridge.",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "allowedVLANs": {
                          "description": "VLAN IDs or VLAN ID ranges (e.g. \"100\", \"200-300\") allowed on this interface. If not specified, all VLANs are allowed.",
                          "items": {
                            "pattern": "^((?:[0-9]{1,3}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-4])|(?:[0-9]{1,3}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-4])-(?:[0-9]{1,3}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-4]))$",
                            "type": "string"
                          },
                          "type": "array",
                          "x-kubernetes-list-type": "set"
                        },
                        "name": {
                          "description": "Name of the physical interface.",
                          "maxLength": 15,
                          "minLength": 1,
                          "pattern": "^[a-zA-Z0-9._-]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "type": "object"
                    },
                    "maxItems": 8,
                    "type": "array",
                    "x-kubernetes-list-map-keys": [
                      "name"
                    ],
                    "x-kubernetes-list-type": "map"
                  }
                },
                "required": [
                  "bridgeName"
                ],
                "type": "object"
              },
              "maxItems": 1,
              "type": "array",
              "x-kubernetes-list-map-keys": [
                "bridgeName"
              ],
              "x-kubernetes-list-type": "map",
              "x-kubernetes-validations": [
                {
                  "message": "bridgeName is immutable — existing bridge names cannot be removed or renamed",
                  "rule": "oldSelf.all(o, self.exists(s, s.bridgeName == o.bridgeName))"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "required": [
        "nodeSelector"
      ],
      "type": "object"
    }
  },
  "required": [
    "spec"
  ],
  "type": "object",
  "x-flux-schema-type": "AntreaNodeConfig"
}
